<!-- This is a placeholder for FEMO logo - will be created as SVG -->
<svg width="200" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="femoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34D399;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1" />
    </linearGradient>
  </defs>
  <circle cx="100" cy="100" r="90" fill="url(#femoGradient)" stroke="#065F46" stroke-width="4"/>
  <text x="100" y="85" font-family="Arial, sans-serif" font-size="36" font-weight="bold" text-anchor="middle" fill="white">FEMO</text>
  <text x="100" y="115" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="white">Mentorship</text>
</svg>
